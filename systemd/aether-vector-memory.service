[Unit]
Description=AetherOS Vector Memory Agent
After=aether-bootstrap.service aether-orchestrator.service
Requires=aether-bootstrap.service

[Service]
Type=simple
ExecStart=/home/miqua/Desktop/pcfAI/bin/aether-vector-memory
Restart=always
RestartSec=3
WorkingDirectory=/home/miqua/Desktop/pcfAI
Environment=PYTHONPATH=/home/miqua/Desktop/pcfAI/lib
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
