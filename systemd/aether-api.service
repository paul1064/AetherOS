[Unit]
Description=AetherOS Local Control API
After=aether-bootstrap.service aether-orchestrator.service aether-executor.service
Requires=aether-bootstrap.service

[Service]
Type=simple
ExecStart=/home/miqua/Desktop/pcfAI/bin/aether-api
Restart=always
RestartSec=3
WorkingDirectory=/home/miqua/Desktop/pcfAI
Environment=PYTHONPATH=/home/miqua/Desktop/pcfAI/lib
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
