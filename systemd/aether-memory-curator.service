[Unit]
Description=AetherOS Memory Curator
After=aether-bootstrap.service aether-vector-memory.service
Requires=aether-bootstrap.service

[Service]
Type=simple
ExecStart=/home/miqua/Desktop/AetherOS/bin/aether-memory-curator
Restart=always
RestartSec=3
WorkingDirectory=/home/miqua/Desktop/AetherOS
Environment=PYTHONPATH=/home/miqua/Desktop/AetherOS/lib
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
