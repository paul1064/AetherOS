[Unit]
Description=AetherOS Meta Agent
After=aether-bootstrap.service aether-supervisor.service
Requires=aether-bootstrap.service

[Service]
Type=simple
ExecStart=/home/miqua/Desktop/AetherOS/bin/aether-meta-agent-service
Restart=always
RestartSec=5
WorkingDirectory=/home/miqua/Desktop/AetherOS
Environment=PYTHONPATH=/home/miqua/Desktop/AetherOS/lib
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
