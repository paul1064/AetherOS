[Unit]
Description=AetherOS Resource Intelligence Agent
After=aether-bootstrap.service
Requires=aether-bootstrap.service

[Service]
Type=simple
ExecStart=/home/miqua/Desktop/AetherOS/bin/aether-resource
Restart=always
RestartSec=5
WorkingDirectory=/home/miqua/Desktop/AetherOS
Environment=PYTHONPATH=/home/miqua/Desktop/AetherOS/lib
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
