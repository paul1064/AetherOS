[Unit]
Description=AetherOS Orchestrator
After=network-online.target ollama.service aether-bootstrap.service
Wants=network-online.target ollama.service
Requires=aether-bootstrap.service

[Service]
Type=simple
ExecStart=/home/miqua/Desktop/AetherOS/bin/aether-orchestrator
Restart=always
RestartSec=3
WorkingDirectory=/home/miqua/Desktop/AetherOS
Environment=PYTHONPATH=/home/miqua/Desktop/AetherOS/lib
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
