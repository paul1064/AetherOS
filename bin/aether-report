#!/usr/bin/env python3
# MIT License

from __future__ import annotations

import json
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

def discover_project_root() -> Path:
    for candidate in Path(__file__).resolve().parents:
        if (candidate / "config" / "aether.yaml").exists():
            return candidate
    raise RuntimeError("Unable to determine AetherOS project root")


PROJECT_ROOT = discover_project_root()
sys.path.insert(0, str(PROJECT_ROOT / "lib"))

from aether_core import (
    fetch_agent_states,
    fetch_meta_jobs,
    list_entities,
    list_governance_profiles,
    latest_plan,
    latest_proposal,
    latest_resource_sample,
    load_config,
    list_models,
    recent_audit,
    recent_long_term_memories,
    recent_remediations,
    recent_system_events,
)


def collect_journal(unit_name: str, lines: int = 20) -> str:
    proc = subprocess.run(
        ["journalctl", "-u", unit_name, "-n", str(lines), "--no-pager"],
        text=True,
        capture_output=True,
        timeout=60,
    )
    return (proc.stdout + "\n" + proc.stderr).strip()


def build_report() -> dict:
    return {
        "generated_at": datetime.now(UTC).isoformat().replace("+00:00", "Z"),
        "config": load_config().raw,
        "version": (PROJECT_ROOT / "VERSION").read_text(encoding="utf-8").strip() if (PROJECT_ROOT / "VERSION").exists() else "unknown",
        "agents": [dict(row) for row in fetch_agent_states()],
        "latest_plan": latest_plan(),
        "latest_proposal": dict(latest_proposal()) if latest_proposal() else None,
        "latest_resource_sample": dict(latest_resource_sample()) if latest_resource_sample() else None,
        "models": [dict(row) for row in list_models()],
        "recent_remediations": [dict(row) for row in recent_remediations()],
        "recent_system_events": [dict(row) for row in recent_system_events()],
        "recent_audit": [dict(row) for row in recent_audit()],
        "governance_profiles": [dict(row) for row in list_governance_profiles()],
        "recent_meta_jobs": [dict(row) for row in fetch_meta_jobs(limit=10)],
        "recent_memories": [dict(row) for row in recent_long_term_memories(limit=10)],
        "entities": [dict(row) for row in list_entities(limit=20)],
        "journals": {
            "aether-api.service": collect_journal("aether-api.service"),
            "aether-orchestrator.service": collect_journal("aether-orchestrator.service"),
            "aether-executor.service": collect_journal("aether-executor.service"),
            "aether-meta.service": collect_journal("aether-meta.service"),
        },
    }


def main() -> int:
    report_dir = PROJECT_ROOT / "data" / "reports"
    report_dir.mkdir(parents=True, exist_ok=True)
    path = report_dir / f"aether-report-{datetime.now(UTC).strftime('%Y%m%d-%H%M%S')}.json"
    path.write_text(json.dumps(build_report(), indent=2), encoding="utf-8")
    print(str(path))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
