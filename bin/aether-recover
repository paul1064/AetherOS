#!/usr/bin/env bash
# MIT License

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

echo "[INFO] Running verification"
"${PROJECT_ROOT}/bin/aether-verify" || true

echo "[INFO] Restarting core AetherOS services"
"${PROJECT_ROOT}/bin/aether-up"

echo "[INFO] Exporting diagnostic report"
"${PROJECT_ROOT}/bin/aether-report"
