#!/usr/bin/env bash
# MIT License

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

if [[ -f "${PROJECT_ROOT}/VERSION" ]]; then
  echo "AetherOS $(cat "${PROJECT_ROOT}/VERSION")"
else
  echo "AetherOS version unknown"
fi
