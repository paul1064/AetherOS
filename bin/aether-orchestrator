#!/home/miqua/Desktop/pcfAI/.venv/bin/python
# MIT License

from __future__ import annotations

import json
import sys
from pathlib import Path

PROJECT_ROOT = Path("/home/miqua/Desktop/pcfAI")
sys.path.insert(0, str(PROJECT_ROOT / "lib"))

from aether_core import (
    emit_event,
    fetch_pending_events,
    init_event_bus,
    load_config,
    mark_event_done,
    ollama_generate,
    propose_command,
    record_system_event,
    sleep_loop,
)

LOG_PATH = PROJECT_ROOT / "runtime" / "logs" / "orchestrator.log"


def log(message: str) -> None:
    LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
    with LOG_PATH.open("a", encoding="utf-8") as handle:
        handle.write(f"{message}\n")


def handle_user_prompt(payload: dict) -> None:
    user_input = payload["text"]
    prompt = f"""
You are the AetherOS orchestration brain.
Convert the user request into a short execution plan.

User request:
{user_input}

Return strict JSON with keys:
summary, intent, suggested_command, reason, needs_confirmation

Rules:
- default to safe read-only commands
- do not use destructive commands
- if uncertain, suggested_command must be empty
"""
    try:
        result = ollama_generate(prompt)
        log(f"model_output={result}")
    except Exception as exc:
        message = f"ollama_generate_failed: {exc}"
        log(message)
        record_system_event("orchestrator", "error", message)
        emit_event(
            "orchestrator.plan.created",
            "orchestrator",
            {
                "summary": "Model unavailable",
                "intent": "degraded",
                "suggested_command": "",
                "reason": message,
                "needs_confirmation": True,
            },
        )
        return

    try:
        parsed = json.loads(result)
    except json.JSONDecodeError:
        parsed = {
            "summary": "Model returned invalid JSON",
            "intent": "unknown",
            "suggested_command": "",
            "reason": "Parsing failure",
            "needs_confirmation": True,
        }

    command = parsed.get("suggested_command", "").strip()
    proposal_id = None
    if command:
        proposal_id = propose_command(
            source="orchestrator",
            user_input=user_input,
            proposed_command=command,
            reason=parsed.get("reason", "No reason provided"),
            needs_confirmation=bool(parsed.get("needs_confirmation", True)),
        )
        parsed["proposal_id"] = proposal_id

    emit_event("orchestrator.plan.created", "orchestrator", parsed)


def main() -> None:
    load_config()
    init_event_bus()
    log("orchestrator_started")

    while True:
        events = fetch_pending_events()
        for event in events:
            try:
                event_type = event["event_type"]
                payload = json.loads(event["payload_json"])

                if event_type == "user.prompt.received":
                    handle_user_prompt(payload)
            except Exception as exc:
                message = f"event_processing_failed id={int(event['id'])}: {exc}"
                log(message)
                record_system_event("orchestrator", "error", message)
            finally:
                mark_event_done(int(event["id"]))

        sleep_loop(2)


if __name__ == "__main__":
    main()
