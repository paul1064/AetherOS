#!/usr/bin/env bash
# MIT License

set -euo pipefail

export XDG_CURRENT_DESKTOP=AetherOS
export XDG_SESSION_DESKTOP=AetherOS
export XDG_SESSION_TYPE=wayland

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
  dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE || true
fi

exec Hyprland -c /home/miqua/Desktop/pcfAI/desktop/hypr/hyprland.conf
